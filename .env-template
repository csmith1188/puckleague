# Public URL of this app (no trailing slash)
# Local: http://localhost:3000
URL=http://localhost:3000

# SQLite database path for Adventure Mode
DATABASE_PATH=db/adventure.db

# Session secret (use a long random string)
FORMBAR_SESSION_SECRET=change_me_to_a_long_random_string

# Formbar base URL (no trailing slash)
# FORMBAR_ADDRESS=https://formbar.yorktechapps.com
# FORMBAR_ADDRESS=https://formbeta.yorktechapps.com
FORMBAR_ADDRESS=https://formbar.yorktechapps.com

# Formbar API key for socket DigiPog transfers
API_KEY=your_formbar_api_key_here

# DigiPog pool that receives Adventure payments
POOL_ID=your_pool_id_here

# Owner account for refunds (optional)
OWNER_ID=your_owner_id_here
OWNER_PIN=your_owner_pin_here

# Extra Game Master Formbar user IDs (comma-separated).
# Teachers (permissions >= 4) are GMs automatically.
GM_IDS=
